# =============================================================================
# MediSign-AI Central Configuration File (.env)
# =============================================================================

# Server settings
MEDISIGN_HOST=0.0.0.0
MEDISIGN_PORT=8000

# Model file paths (relative to emergency/ directory)
EMERGENCY_MODEL_PATH=emergency_model_v2.pkl
SIGN_MODEL_PATH=backend/models/gesture_model_full.pkl
HAND_LANDMARKER_TASK_PATH=hand_landmarker.task

# Prediction thresholds
EMERGENCY_CONFIDENCE_THRESHOLD=0.80
SIGN_CONFIDENCE_THRESHOLD=0.70

# Logging configurations
MEDISIGN_LOG_LEVEL=INFO
