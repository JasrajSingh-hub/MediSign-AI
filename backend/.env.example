# Choose the text-to-speech provider: 'edge' (online, high quality) or 'pyttsx3' (offline, native OS)
TTS_PROVIDER=edge

# FastAPI TTS Service Port
TTS_PORT=5001

# Rate limiting settings (max requests per client IP per window)
RATE_LIMIT_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=60

# OpenRouter API Key for AI features
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini API Key for AI features
GEMINI_API_KEY=your_gemini_api_key_here


